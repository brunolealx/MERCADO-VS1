        String arquivoCsv = "seu_arquivo_original.csv"; // O CSV que você tirou do XLSX

        try (BufferedReader br = new BufferedReader(new InputStreamReader(
                new FileInputStream(arquivoCsv), StandardCharsets.UTF_8))) {
            
            String linha;
            br.readLine(); // Pula o cabeçalho

            while ((linha = br.readLine()) != null) {
                // Separa por vírgula tratando aspas
                String[] col = linha.split(",(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)");
                
                if (col.length >= 22) {
                    String ean       = limpar(col[0]);
                    String descricao = limpar(col[1]);
                    String marca     = limpar(col[2]);
