    t = t.replace("_x005F_x0080_", "Ç")
         .replace("_x005F_x0090_", "Ê")
         .replace("_x005F_x000D_", "") 
         .replace("_x005F_x001B_", "");

    // 2. TRADUTOR DE "MUTILAÇÕES" (O que você encontrou e os prováveis próximos)
    t = t.replace("Pà", "PÓ")   // O que você acabou de achar
         .replace("Pµ", "PÁ")   // O que achamos antes
         .replace("Âµ", "Á")
         .replace("Â©", "É")
         .replace("Âª", "Ê")
         .replace("Ã‡", "Ç")
         .replace("Ã‰", "É")
         .replace("Ã“", "Ó")
         .replace("Ãƒ", "Ã")
         .replace("ÃŠ", "Ê")
         .replace("Ã ", "à")
