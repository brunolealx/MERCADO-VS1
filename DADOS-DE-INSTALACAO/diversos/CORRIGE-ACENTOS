-- Passo 1: Converter o código geral para É (atende CARRÉ e CHAPÉU)
UPDATE public.tabela_produtos 
SET 
    descricao = REPLACE(descricao, '_x0090_', 'E'),
    marca = REPLACE(marca, '_x0090_', 'E')
WHERE descricao LIKE '%_x0090_%' OR marca LIKE '%_x0090_%';


-- Passo 2: Corrigir especificamente a NESTLÊ (caso você prefira com Ê)
UPDATE public.tabela_produtos 
SET 
    descricao = REPLACE(descricao, 'NESTLÉ', 'NESTLE'),
    marca = REPLACE(marca, 'NESTLÉ', 'NESTLE')
WHERE descricao LIKE '%NESTLÉ%' OR marca LIKE '%NESTLÉ%';

-- Passo 3: Limpeza de outros códigos hexadecimais que sobraram
UPDATE public.tabela_produtos 
SET 
    descricao = REPLACE(descricao, '_x000D_', ''), 
    marca = REPLACE(marca, '_x000D_', '')
WHERE descricao LIKE '%_x000D_%' OR marca LIKE '%_x000D_%';
